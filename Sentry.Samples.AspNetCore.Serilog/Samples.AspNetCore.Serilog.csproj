    <ProjectReference Include="..\..\src\Sentry.AspNetCore\Sentry.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Sentry.Serilog\Sentry.Serilog.csproj" />
  </ItemGroup>-->

</Project>
